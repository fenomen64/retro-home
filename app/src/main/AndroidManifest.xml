<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Видеть установленные приложения с иконкой в меню -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <!-- Виджеты других приложений -->
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <!-- Наборы значков -->
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.anddoes.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.teslacoilsw.launcher.THEME" />
        </intent>
        <!-- Какие приложения открывают файлы игр: так опознаются новые эмуляторы -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:mimeType="*/*" />
        </intent>
        <!-- Lemuroid открывает игры только по своим ссылкам lemuroid:// -->
        <package android:name="com.swordfish.lemuroid" />
    </queries>

    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Вибрация при навигации в консольном режиме -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Свайп вниз по рабочему столу открывает шторку уведомлений -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Точный учёт времени в играх: пользователь сам включает в настройках Android -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- Обложки (libretro) и описания (Википедия) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Обновление лаунчера из него самого: система всё равно спрашивает подтверждение у пользователя -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Предупреждение «RetroAchievements недоступен» перед игрой (включается в настройках) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Режим приложения: служба на время игры, чтобы Android не замораживал проверки RetroAchievements -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Расписание проверки обновлений переживает перезагрузку -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".LauncherApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RetroHome">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:screenOrientation="fullUser"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Значок в списке приложений: Retro Home как обычное приложение, без замены своего лаунчера.
             Отдельная задача — чтобы быть в списке открытых приложений и возвращаться сюда после игры -->
        <activity
            android:name=".AppModeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.retrohome.launcher.app"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Результат установки обновления (окно подтверждения системы) -->
        <receiver android:name=".data.UpdateReceiver" android:exported="false" />

        <!-- Слежение за RetroAchievements во время игры (только в режиме приложения) -->
        <service
            android:name=".data.RaWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Checks RetroAchievements server availability while the user plays a game, to warn when earned achievements cannot be submitted" />
        </service>

        <!-- Проверка обновлений по расписанию (раз в 15 минут), даже когда приложение закрыто -->
        <service
            android:name=".data.UpdateJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Ярлыки игр из Lemuroid («Создать ярлык»): так лаунчер узнаёт номер игры в его библиотеке -->
        <activity
            android:name=".PinShortcutActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
